set tabsize 4
set nowrap
set autoindent
set wordbounds

# nanorc has no variable expansion, so the homebrew prefix cannot be shared
# with zshrc_mac. The glob covers both /opt/homebrew (Apple silicon) and
# /opt/brew (custom prefix on the Intel machine).
include "/opt/*/share/nano/*.nanorc"

bind M-F nextword main
bind M-B prevword main
bind M-U undo main
bind M-E redo main
