############### POWERLEVEL10K INSTANT PROMPT ################
# MUST stay at the very top of this file. Anything that produces output or
# reads from stdin above this point breaks the instant prompt.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

############### ENVIRONMENT ################
# The prefix differs per machine: /opt/homebrew on Apple silicon, /opt/brew
# where a custom prefix was used, /usr/local on stock Intel. Probe for it
# rather than calling `brew --prefix`: the latter forks a Ruby/bash script on
# every single shell startup. First hit wins, so keep the list most-specific
# first (/usr/local exists everywhere, but only holds brew on stock Intel).
for _brew_prefix in /opt/homebrew /opt/brew /usr/local; do
  if [[ -x "$_brew_prefix/bin/brew" ]]; then
    export HOMEBREW_PREFIX="$_brew_prefix"
    break
  fi
done
unset _brew_prefix
export HISTFILE="$HOME/.zsh_history"
export HISTSIZE=100000000
export SAVEHIST=100000000
export FPATH=$HOME/dotfiles/zsh_autocomplete_rclone:$FPATH
export VISUAL=nano
export EDITOR="$VISUAL"
export ZSH_DISABLE_COMPFIX=true
export LANG="en_US.UTF-8"
export LC_ADDRESS=it_IT.UTF-8
export LC_COLLATE=it_IT.UTF-8
export LC_MEASUREMENT=it_IT.UTF-8
export LC_MONETARY=it_IT.UTF-8
export LC_NAME=it_IT.UTF-8
export LC_NUMERIC=it_IT.UTF-8
export LC_PAPER=C
export LC_TELEPHONE=it_IT.UTF-8
export LC_TIME=C

############### PATH ################
if [[ -n "$HOMEBREW_PREFIX" ]]; then
  export PATH="$HOMEBREW_PREFIX/bin:$PATH"
  export PATH="$HOMEBREW_PREFIX/opt/python/libexec/bin:$PATH"
fi

# Added by Antigravity (guarded: the original hardcoded /Users/ceres path is
# for a different user account and does not exist here).
[[ -d "$HOME/.antigravity/antigravity/bin" ]] && \
  export PATH="$HOME/.antigravity/antigravity/bin:$PATH"

############### PREZTO ################
# Sourced BEFORE powerlevel10k so prezto can never override the prompt.
# NOTE: init.zsh sources ~/.zpreztorc itself -- do not source it manually.
# The 'prompt' pmodule is removed from ~/.zpreztorc so sorin cannot fight p10k.
source "${HOME}/.zprezto/init.zsh"

############### POWERLEVEL 10K ################
# All POWERLEVEL9K_* settings must be assigned BEFORE the theme is sourced.
# p10k snapshots its configuration at load time; later assignments are silently
# ignored unless followed by an explicit `p10k reload`.

# There is no ~/.p10k.zsh on this machine, so configure inline and suppress the
# interactive wizard. Without this, p10k blocks the shell waiting for keypresses
# -- that is what made VS Code report commands as never finishing.
typeset -g POWERLEVEL9K_DISABLE_CONFIGURATION_WIZARD=true

# Make p10k emit the OSC 133/633 marks itself. This is the actual fix for VS
# Code shell integration: p10k rebuilds PROMPT on every redraw, wiping the
# markers VS Code injects, so VS Code never sees command-end.
typeset -g POWERLEVEL9K_TERM_SHELL_INTEGRATION=true

typeset -g POWERLEVEL9K_MODE='nerdfont-complete'

typeset -g POWERLEVEL9K_BATTERY_VERBOSE=false
typeset -g POWERLEVEL9K_BATTERY_CHARGING='yellow'
typeset -g POWERLEVEL9K_BATTERY_CHARGED='green'
typeset -g POWERLEVEL9K_BATTERY_DISCONNECTED="$DEFAULT_COLOR"
typeset -g POWERLEVEL9K_BATTERY_LOW_THRESHOLD='25'
typeset -g POWERLEVEL9K_BATTERY_LOW_COLOR='red'
typeset -g POWERLEVEL9K_MULTILINE_FIRST_PROMPT_PREFIX=''
# $'...' so the escape actually becomes the glyph rather than a literal \uf0da
typeset -g POWERLEVEL9K_MULTILINE_LAST_PROMPT_PREFIX=$'\uf0da'

typeset -g POWERLEVEL9K_VCS_MODIFIED_BACKGROUND='yellow'
typeset -g POWERLEVEL9K_VCS_UNTRACKED_BACKGROUND='yellow'

typeset -g POWERLEVEL9K_LEFT_PROMPT_ELEMENTS=(status user dir vcs)
typeset -g POWERLEVEL9K_RIGHT_PROMPT_ELEMENTS=(time virtualenv)

typeset -g POWERLEVEL9K_SHORTEN_STRATEGY="truncate_middle"
typeset -g POWERLEVEL9K_SHORTEN_DIR_LENGTH=4

typeset -g POWERLEVEL9K_TIME_FORMAT="%D{%H:%M}"

typeset -g POWERLEVEL9K_PROMPT_ON_NEWLINE=true

_p10k_theme="$HOMEBREW_PREFIX/share/powerlevel10k/powerlevel10k.zsh-theme"
if [[ -r "$_p10k_theme" ]]; then
  source "$_p10k_theme"
else
  print -u2 "zshrc: powerlevel10k not found at $_p10k_theme (brew install powerlevel10k)"
fi
unset _p10k_theme

# If a generated config ever appears (via `p10k configure`), let it win.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
############# END POWERLEVEL 10K ##############

############### ALIASES ################
alias lschmod='ls -la | awk '\''{k=0;for(i=0;i<=8;i++)k+=((substr($1,i+2,1)~/[rwx]/)*2^(8-i));if(k)printf("%0o ",k);print}'\'
alias l1="ls -1"
alias la="ls -la"
alias rm='nocorrect rm'

############### KEYBINDINGS ################
# After prezto's `editor` module, otherwise these get clobbered.
# '^[f' is the escape sequence for Alt/Meta-f; "<ESC>f" bound the literal
# 5-character string "<ESC>f" and never worked.
bindkey '^[f' forward-word
bindkey '^[b' backward-word

############### VS CODE SHELL INTEGRATION ################
# VS Code reports "Shell integration: Rich" only when it receives
#   \e]633;P;HasRichCommandDetection=True
# which ONLY its own shellIntegration-rc.zsh emits (p10k never does). Internally
# the check is literally `hasRichCommandDetection ? "rich" : "basic"`, so without
# that one sequence the terminal is stuck on "Basic".
#
# The complication: p10k.zsh runs an unconditional `unset
# VSCODE_SHELL_INTEGRATION` during init. In the INJECTED path VS Code sources
# this .zshrc from the middle of its own script, so p10k's unset happens before
# the script's `[ -z "$VSCODE_SHELL_INTEGRATION" ] && return` guard -- the script
# then bails out and defines nothing. Net effect: injection alone yields zero
# __vsc_* functions and only p10k's OSC 133 marks, i.e. "Basic".
#
# Fix: source the script here, at the END of .zshrc, after p10k has finished --
# with VSCODE_SHELL_INTEGRATION and VSCODE_INJECTION both unset first (see the
# comment on the pre-state below; getting either wrong makes this a no-op or
# recurses infinitely).
if [[ "$TERM_PROGRAM" == "vscode" ]]; then
  # In the injected case the script is at $VSCODE_ZDOTDIR/.zshrc; otherwise ask
  # `code`. `code --locate-shell-integration-path` forks node (~100ms), so only
  # fall back to it when the injected copy is not available.
  _vsc_si_path=""
  if [[ -n "$VSCODE_ZDOTDIR" && -r "$VSCODE_ZDOTDIR/.zshrc" ]]; then
    _vsc_si_path="$VSCODE_ZDOTDIR/.zshrc"
  else
    _vsc_si_path="$(code --locate-shell-integration-path zsh 2>/dev/null)"
  fi
  if [[ -n "$_vsc_si_path" && -r "$_vsc_si_path" ]]; then
    # The pre-state here is load-bearing; both variables must be UNSET:
    #   VSCODE_SHELL_INTEGRATION -- if set, the script's recursion guard at the
    #     top returns immediately and defines nothing. (Setting it to 1 to
    #     "re-arm" is exactly wrong; it silently disables the script.)
    #   VSCODE_INJECTION -- if 1, the script re-sources $USER_ZDOTDIR/.zshrc,
    #     which is THIS file: infinite recursion.
    # $USER_ZDOTDIR must still be set so the script restores ZDOTDIR correctly.
    : ${USER_ZDOTDIR:=$HOME}
    unset VSCODE_SHELL_INTEGRATION VSCODE_INJECTION
    source "$_vsc_si_path"
  fi
  unset _vsc_si_path
fi

