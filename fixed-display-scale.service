[Unit]
Description=Keep GNOME display scale fixed (undo scale resets on Parallels display switches)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/bin/fixed-display-scale.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
